# ══════════════════════════════════════════════════════════════
# Trace Cattle — Configuración de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env real a Git ni lo compartas.
# ══════════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────────────
# En Railway esta variable la inyecta automáticamente el plugin de PostgreSQL.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PruebaTC

# ── JWT ───────────────────────────────────────────────────────
# Genera una clave aleatoria con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── AES-256 (cifrado de plantillas biométricas) ───────────────
# 64 caracteres hexadecimales (32 bytes). Genera una con el mismo comando de arriba.
AES_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. Agrega aquí tu dominio de producción.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Administrador del sistema ─────────────────────────────────
ADMIN_EMAIL=admin@tracecattle.com
ADMIN_PASSWORD=

# ── Email / SMTP (códigos de cambio biométrico) ───────────────
# Para Gmail necesitas una "Contraseña de aplicación".
# Si se dejan vacíos, los códigos se imprimen en la consola (modo dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
